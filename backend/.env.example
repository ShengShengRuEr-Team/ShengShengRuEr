# 复制为 backend/.env 后填写真实值；.env 已被 .gitignore 忽略，禁止提交。
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/shengshengruer
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 模块二：音频受控目录（相对 backend/ 解析；音频本体不入库、不进 Git）
AUDIO_STORAGE_DIR=var/audio
# 模块三：API、独立worker和OCR子进程使用同一份配置。
# 环境与资源准备见 docs/development/module-3/testing-guide.md。
M3_MATERIALS_DIR=var/materials
M3_ARTIFACTS_DIR=var/processing
M3_MODEL_ROOT=var/models
M3_PROFILE_PATH=config/module3/processing-profile.json
# 以下解释器和资源路径须替换为本机绝对路径；三个Python环境分别安装锁文件。
M3_ASR_PYTHON=C:/path/to/backend/.venv-asr/Scripts/python.exe
M3_OCR_PYTHON=C:/path/to/backend/.venv-ocr/Scripts/python.exe
FFMPEG_DLL_DIR=C:/path/to/ffmpeg-7.1.1-full_build-shared/bin
NLTK_DATA=C:/path/to/nltk_data
# 仅关联标注阶段需要；填写自己的密钥，不要提交真实.env。
DEEPSEEK_API_KEY=
